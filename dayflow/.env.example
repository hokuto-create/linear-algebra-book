# ============================================================
# DayFlow 収益化システム — 環境変数一覧
#
# 【重要】このファイルの値はすべて Supabase の Edge Function secrets として
# 設定する（クライアント = index.html には絶対に埋め込まない）。
#
#   supabase secrets set --env-file ./dayflow/.env   # 例
#
# クライアントに埋め込んでよいのは SUPABASE_URL / SUPABASE_ANON_KEY と
# STRIPE_PORTAL_LOGIN_URL（公開可能なノーコードポータルURL）だけ。
# ============================================================

# --- Stripe（テストは sk_test_ / whsec_ から始まるキーを使う） ---
STRIPE_SECRET_KEY=<sk_test_ から始まるシークレットキー>
STRIPE_WEBHOOK_SECRET=<whsec_ から始まる署名シークレット>

# --- Stripe Price ID（プラン×期間の4つ。README の手順で作成） ---
STRIPE_PRICE_STANDARD_MONTHLY=price_xxxxxxxxxxxxxxxx   # スタンダード ¥600/月
STRIPE_PRICE_STANDARD_YEARLY=price_xxxxxxxxxxxxxxxx    # スタンダード ¥6,000/年
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxxxxxxxxxxxxxx    # プレミアム ¥1,000/月
STRIPE_PRICE_PREMIUM_YEARLY=price_xxxxxxxxxxxxxxxx     # プレミアム ¥10,000/年

# --- Anthropic（AI目次取り込み・プレミアム機能） ---
ANTHROPIC_API_KEY=<sk-ant- から始まるAPIキー>
# 精度優先のデフォルト。コスト最適化したい場合のみ claude-haiku-4-5 に変更可
ANTHROPIC_MODEL=claude-opus-4-8

# --- AI目次取り込みの日次回数上限（1ユーザーあたり） ---
AI_DAILY_LIMIT=20

# --- アプリの公開URL（Checkout の success/cancel リダイレクト先） ---
APP_URL=https://your-dayflow-app.example.com

# ============================================================
# 以下はクライアント側（index.html）に直接書く公開値（secret ではない）
# ============================================================
# Stripe Customer Portal のノーコード・ログインリンク
# （ダッシュボード → 設定 → Billing → カスタマーポータル で有効化して取得）
# STRIPE_PORTAL_LOGIN_URL=https://billing.stripe.com/p/login/test_xxxxxxxx
